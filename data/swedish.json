  "dialogues": [
    {
      "id": "swedish-d01",
      "title": "첫 만남",
      "lines": [
        {
          "who": "A",
          "text": "Hej! Vad heter du?",
          "meaning": "안녕하세요! 이름이 뭐예요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Jag heter Min. Och du?",
          "meaning": "저는 민이에요. 당신은요?",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Jag heter Elsa.",
          "meaning": "저는 엘사예요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Trevligt att träffas.",
          "meaning": "반가워요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "swedish-d02",
      "title": "카페 주문",
      "lines": [
        {
          "who": "A",
          "text": "Hej! Vad vill du ha?",
          "meaning": "안녕하세요! 무엇을 드릴까요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "En kaffe, tack.",
          "meaning": "커피 한 잔 주세요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Vill du ha mjölk?",
          "meaning": "우유를 넣으시겠어요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Nej tack, utan mjölk.",
          "meaning": "아니요. 우유는 빼 주세요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "swedish-d03",
      "title": "길 묻기",
      "lines": [
        {
          "who": "A",
          "text": "Ursäkta, var ligger stationen?",
          "meaning": "실례합니다. 역이 어디예요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Gå rakt fram och sväng höger.",
          "meaning": "곧장 가서 오른쪽으로 도세요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Är det långt?",
          "meaning": "먼가요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Nej, fem minuter till fots.",
          "meaning": "아니요. 걸어서 5분이에요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "swedish-d04",
      "title": "계산하기",
      "lines": [
        {
          "who": "A",
          "text": "Vad kostar det?",
          "meaning": "이것은 얼마예요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Tjugo kronor.",
          "meaning": "20크로나예요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Kan jag betala med kort?",
          "meaning": "카드로 계산할 수 있나요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Ja, det går bra.",
          "meaning": "네, 괜찮아요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "swedish-d05",
      "title": "기차 타기",
      "lines": [
        {
          "who": "A",
          "text": "När går tåget?",
          "meaning": "기차는 언제 출발해요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Klockan tio.",
          "meaning": "10시에요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Från vilket spår?",
          "meaning": "몇 번 승강장에서 출발하나요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Från spår två.",
          "meaning": "2번 승강장이에요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "swedish-d06",
      "title": "체크인",
      "lines": [
        {
          "who": "A",
          "text": "Jag har en bokning.",
          "meaning": "예약했어요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Vad heter du?",
          "meaning": "성함이 어떻게 되세요?",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Jag heter Min Kim.",
          "meaning": "제 이름은 민 김이에요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Välkommen!",
          "meaning": "환영합니다!",
          "reading": ""
        }
      ]
    },
    {
      "id": "swedish-d07",
      "title": "천천히 부탁하기",
      "lines": [
        {
          "who": "A",
          "text": "Jag förstår inte.",
          "meaning": "이해하지 못했어요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Ska jag säga det igen?",
          "meaning": "다시 말해 드릴까요?",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Ja, lite långsammare, tack.",
          "meaning": "네, 조금 천천히 부탁해요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Självklart.",
          "meaning": "물론이에요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "swedish-d08",
      "title": "내일 약속",
      "lines": [
        {
          "who": "A",
          "text": "Har du tid imorgon?",
          "meaning": "내일 시간 있어요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Ja, på eftermiddagen.",
          "meaning": "네, 오후에요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Ska vi ta en fika?",
          "meaning": "커피 한잔하며 쉴까요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Gärna! Vi ses imorgon.",
          "meaning": "좋아요! 내일 봐요.",
          "reading": ""
        }
      ]
    }
  ]
