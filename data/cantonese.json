  "dialogues": [
    {
      "id": "cantonese-d01",
      "title": "첫 만남",
      "lines": [
        {
          "who": "A",
          "text": "你好。",
          "meaning": "안녕하세요.",
          "reading": "nei5 hou2"
        },
        {
          "who": "B",
          "text": "你好，你叫咩名？",
          "meaning": "안녕하세요. 이름이 뭐예요?",
          "reading": "nei5 hou2 nei5 giu3 me1 meng2"
        },
        {
          "who": "A",
          "text": "我叫阿明。",
          "meaning": "제 이름은 아밍이에요.",
          "reading": "ngo5 giu3 aa3 ming4"
        },
        {
          "who": "B",
          "text": "好高興識你。",
          "meaning": "만나서 반가워요.",
          "reading": "hou2 gou1 hing3 sik1 nei5"
        }
      ]
    },
    {
      "id": "cantonese-d02",
      "title": "차 주문",
      "lines": [
        {
          "who": "A",
          "text": "飲咩呀？",
          "meaning": "무엇을 마실래요?",
          "reading": "jam2 me1 aa3"
        },
        {
          "who": "B",
          "text": "唔該，一杯茶。",
          "meaning": "차 한 잔 주세요.",
          "reading": "m4 goi1 jat1 bui1 caa4"
        },
        {
          "who": "A",
          "text": "熱嘅定凍嘅？",
          "meaning": "뜨거운 것으로요, 차가운 것으로요?",
          "reading": "jit6 ge3 ding6 dung3 ge3"
        },
        {
          "who": "B",
          "text": "熱嘅，唔該。",
          "meaning": "뜨거운 것으로 주세요.",
          "reading": "jit6 ge3 m4 goi1"
        }
      ]
    },
    {
      "id": "cantonese-d03",
      "title": "길 묻기",
      "lines": [
        {
          "who": "A",
          "text": "唔該，車站喺邊度？",
          "meaning": "실례합니다. 역이 어디예요?",
          "reading": "m4 goi1 ce1 zaam6 hai2 bin1 dou6"
        },
        {
          "who": "B",
          "text": "一直行，轉左。",
          "meaning": "곧장 가서 왼쪽으로 도세요.",
          "reading": "jat1 zik6 haang4 zyun3 zo2"
        },
        {
          "who": "A",
          "text": "遠唔遠？",
          "meaning": "먼가요?",
          "reading": "jyun5 m4 jyun5"
        },
        {
          "who": "B",
          "text": "唔遠。",
          "meaning": "멀지 않아요.",
          "reading": "m4 jyun5"
        }
      ]
    },
    {
      "id": "cantonese-d04",
      "title": "계산하기",
      "lines": [
        {
          "who": "A",
          "text": "呢個幾多錢？",
          "meaning": "이것은 얼마예요?",
          "reading": "ni1 go3 gei2 do1 cin2"
        },
        {
          "who": "B",
          "text": "二十蚊。",
          "meaning": "20달러예요.",
          "reading": "ji6 sap6 man1"
        },
        {
          "who": "A",
          "text": "可唔可以用信用卡？",
          "meaning": "신용카드를 쓸 수 있나요?",
          "reading": "ho2 m4 ho2 ji5 jung6 seon3 jung6 kaat1"
        },
        {
          "who": "B",
          "text": "可以。",
          "meaning": "가능해요.",
          "reading": "ho2 ji5"
        }
      ]
    },
    {
      "id": "cantonese-d05",
      "title": "버스 확인",
      "lines": [
        {
          "who": "A",
          "text": "呢架巴士去唔去中環？",
          "meaning": "이 버스는 중완에 가나요?",
          "reading": "ni1 gaa3 baa1 si2 heoi3 m4 heoi3 zung1 waan4"
        },
        {
          "who": "B",
          "text": "去。",
          "meaning": "가요.",
          "reading": "heoi3"
        },
        {
          "who": "A",
          "text": "要幾耐？",
          "meaning": "얼마나 걸려요?",
          "reading": "jiu3 gei2 noi6"
        },
        {
          "who": "B",
          "text": "大概十分鐘。",
          "meaning": "약 10분이에요.",
          "reading": "daai6 koi3 sap6 fan1 zung1"
        }
      ]
    },
    {
      "id": "cantonese-d06",
      "title": "감사 표현",
      "lines": [
        {
          "who": "A",
          "text": "呢份禮物送俾你。",
          "meaning": "이 선물을 드릴게요.",
          "reading": "ni1 fan6 lai5 mat6 sung3 bei2 nei5"
        },
        {
          "who": "B",
          "text": "多謝。",
          "meaning": "감사합니다.",
          "reading": "do1 ze6"
        },
        {
          "who": "A",
          "text": "唔使客氣。",
          "meaning": "천만에요.",
          "reading": "m4 sai2 haak3 hei3"
        },
        {
          "who": "B",
          "text": "我好鍾意。",
          "meaning": "정말 마음에 들어요.",
          "reading": "ngo5 hou2 zung1 ji3"
        }
      ]
    },
    {
      "id": "cantonese-d07",
      "title": "천천히 부탁하기",
      "lines": [
        {
          "who": "A",
          "text": "我唔明。",
          "meaning": "이해하지 못했어요.",
          "reading": "ngo5 m4 ming4"
        },
        {
          "who": "B",
          "text": "你想我再講一次？",
          "meaning": "다시 한 번 말해 줄까요?",
          "reading": "nei5 soeng2 ngo5 zoi3 gong2 jat1 ci3"
        },
        {
          "who": "A",
          "text": "係，唔該講慢啲。",
          "meaning": "네. 천천히 부탁해요.",
          "reading": "hai6 m4 goi1 gong2 maan6 di1"
        },
        {
          "who": "B",
          "text": "好。",
          "meaning": "좋아요.",
          "reading": "hou2"
        }
      ]
    },
    {
      "id": "cantonese-d08",
      "title": "내일 인사",
      "lines": [
        {
          "who": "A",
          "text": "你聽日有冇時間？",
          "meaning": "내일 시간 있어요?",
          "reading": "nei5 ting1 jat6 jau5 mou5 si4 gaan3"
        },
        {
          "who": "B",
          "text": "有。",
          "meaning": "있어요.",
          "reading": "jau5"
        },
        {
          "who": "A",
          "text": "聽日見。",
          "meaning": "내일 봐요.",
          "reading": "ting1 jat6 gin3"
        },
        {
          "who": "B",
          "text": "好，拜拜。",
          "meaning": "좋아요. 잘 가요.",
          "reading": "hou2 baai1 baai3"
        }
      ]
    }
