  "dialogues": [
    {
      "id": "dutch-d01",
      "title": "첫 만남",
      "lines": [
        {
          "who": "A",
          "text": "Hallo!",
          "meaning": "안녕하세요!",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Hallo! Hoe heet je?",
          "meaning": "안녕하세요! 이름이 뭐예요?",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Ik heet Min. En jij?",
          "meaning": "저는 민이에요. 당신은요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Ik heet Emma. Aangenaam.",
          "meaning": "저는 엠마예요. 반가워요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "dutch-d02",
      "title": "카페 주문",
      "lines": [
        {
          "who": "A",
          "text": "Goedemorgen. Wat wilt u drinken?",
          "meaning": "안녕하세요. 무엇을 마시겠어요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Een koffie, alstublieft.",
          "meaning": "커피 한 잔 주세요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Met melk?",
          "meaning": "우유를 넣을까요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Nee, zonder melk. Dank u wel.",
          "meaning": "아니요. 우유는 빼 주세요. 감사합니다.",
          "reading": ""
        }
      ]
    },
    {
      "id": "dutch-d03",
      "title": "길 묻기",
      "lines": [
        {
          "who": "A",
          "text": "Sorry, waar is het station?",
          "meaning": "실례합니다. 역이 어디예요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Ga rechtdoor en sla linksaf.",
          "meaning": "곧장 가서 왼쪽으로 도세요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Is het ver?",
          "meaning": "먼가요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Nee, ongeveer vijf minuten lopen.",
          "meaning": "아니요. 걸어서 약 5분이에요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "dutch-d04",
      "title": "계산하기",
      "lines": [
        {
          "who": "A",
          "text": "Hoeveel kost dit?",
          "meaning": "이것은 얼마예요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Vijf euro.",
          "meaning": "5유로예요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Kan ik met een kaart betalen?",
          "meaning": "카드로 계산할 수 있나요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Ja, natuurlijk.",
          "meaning": "네, 물론이에요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "dutch-d05",
      "title": "기차 타기",
      "lines": [
        {
          "who": "A",
          "text": "Hoe laat vertrekt de trein?",
          "meaning": "기차는 몇 시에 출발해요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Om tien uur.",
          "meaning": "10시에요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Op welk spoor?",
          "meaning": "몇 번 승강장인가요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Op spoor twee.",
          "meaning": "2번 승강장이에요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "dutch-d06",
      "title": "체크인",
      "lines": [
        {
          "who": "A",
          "text": "Ik heb een reservering.",
          "meaning": "예약했어요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Op welke naam?",
          "meaning": "어떤 이름으로 예약하셨어요?",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Op naam van Min.",
          "meaning": "민이라는 이름으로요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Welkom!",
          "meaning": "환영합니다!",
          "reading": ""
        }
      ]
    },
    {
      "id": "dutch-d07",
      "title": "도움 요청",
      "lines": [
        {
          "who": "A",
          "text": "Ik begrijp het niet.",
          "meaning": "이해하지 못했어요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Zal ik het herhalen?",
          "meaning": "다시 말해 드릴까요?",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Ja, graag. Langzamer, alstublieft.",
          "meaning": "네, 부탁드려요. 조금 천천히요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Natuurlijk.",
          "meaning": "물론이에요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "dutch-d08",
      "title": "내일 약속",
      "lines": [
        {
          "who": "A",
          "text": "Heb je morgen tijd?",
          "meaning": "내일 시간 있어요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Ja, in de middag.",
          "meaning": "네, 오후에요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Zullen we koffie drinken?",
          "meaning": "커피 마실까요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Goed idee. Tot morgen!",
          "meaning": "좋아요. 내일 봐요!",
          "reading": ""
        }
      ]
