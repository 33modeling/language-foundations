  "dialogues": [
    {
      "id": "polish-d01",
      "title": "첫 만남",
      "lines": [
        {
          "who": "A",
          "text": "Cześć! Jak masz na imię?",
          "meaning": "안녕! 이름이 뭐예요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Mam na imię Min. A ty?",
          "meaning": "저는 민이에요. 당신은요?",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Mam na imię Anna.",
          "meaning": "저는 안나예요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Miło mi.",
          "meaning": "반가워요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "polish-d02",
      "title": "카페 주문",
      "lines": [
        {
          "who": "A",
          "text": "Dzień dobry. Co podać?",
          "meaning": "안녕하세요. 무엇을 드릴까요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Poproszę kawę.",
          "meaning": "커피 한 잔 주세요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Z mlekiem?",
          "meaning": "우유를 넣을까요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Tak, proszę.",
          "meaning": "네, 부탁해요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "polish-d03",
      "title": "길 묻기",
      "lines": [
        {
          "who": "A",
          "text": "Przepraszam, gdzie jest dworzec?",
          "meaning": "실례합니다. 역이 어디예요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Proszę iść prosto.",
          "meaning": "곧장 가세요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Czy to daleko?",
          "meaning": "먼가요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Nie, pięć minut pieszo.",
          "meaning": "아니요. 걸어서 5분이에요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "polish-d04",
      "title": "계산하기",
      "lines": [
        {
          "who": "A",
          "text": "Ile to kosztuje?",
          "meaning": "이것은 얼마예요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Dziesięć złotych.",
          "meaning": "10즈워티예요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Czy mogę zapłacić kartą?",
          "meaning": "카드로 계산할 수 있나요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Tak, proszę.",
          "meaning": "네, 그렇게 하세요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "polish-d05",
      "title": "기차 타기",
      "lines": [
        {
          "who": "A",
          "text": "O której odjeżdża pociąg?",
          "meaning": "기차는 몇 시에 출발해요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "O dziesiątej.",
          "meaning": "10시에요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Z którego peronu?",
          "meaning": "몇 번 승강장에서 출발하나요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Z peronu drugiego.",
          "meaning": "2번 승강장에서요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "polish-d06",
      "title": "체크인",
      "lines": [
        {
          "who": "A",
          "text": "Mam rezerwację.",
          "meaning": "예약했어요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Na jakie nazwisko?",
          "meaning": "성함이 어떻게 되세요?",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Kim.",
          "meaning": "김입니다.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Proszę bardzo.",
          "meaning": "여기 있습니다.",
          "reading": ""
        }
      ]
    },
    {
      "id": "polish-d07",
      "title": "천천히 부탁하기",
      "lines": [
        {
          "who": "A",
          "text": "Nie rozumiem.",
          "meaning": "이해하지 못했어요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Powtórzyć?",
          "meaning": "다시 말할까요?",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Tak. Proszę mówić wolniej.",
          "meaning": "네. 천천히 말씀해 주세요.",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Dobrze.",
          "meaning": "알겠어요.",
          "reading": ""
        }
      ]
    },
    {
      "id": "polish-d08",
      "title": "내일 약속",
      "lines": [
        {
          "who": "A",
          "text": "Masz jutro czas?",
          "meaning": "내일 시간 있어요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Tak, po południu.",
          "meaning": "네, 오후에요.",
          "reading": ""
        },
        {
          "who": "A",
          "text": "Może kawa?",
          "meaning": "커피 한잔할까요?",
          "reading": ""
        },
        {
          "who": "B",
          "text": "Chętnie. Do jutra!",
          "meaning": "좋아요. 내일 봐요!",
          "reading": ""
        }
      ]
    }
